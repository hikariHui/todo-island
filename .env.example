# 登录密码（必填；生产勿使用 change-me）
AUTH_PASSWORD=change-me

# Session 签名密钥（生产必填，至少 16 字符随机串；与密码分开）
# 修改 AUTH_PASSWORD 时请一并更换 SESSION_SECRET，使旧登录 Cookie 立即失效
SESSION_SECRET=please-change-this-to-a-long-random-string

# 数据目录（本地开发可省略，默认 ./data；Docker 中由 compose 注入）
# DATA_DIR=/app/data

# 业务时区：定点 dueAt / iCal 按此时区的墙钟时间解释（默认 Asia/Shanghai）
# Docker 建议同时设 TZ，与系统本地时间一致
# APP_TIMEZONE=Asia/Shanghai
# TZ=Asia/Shanghai

# iCloud 日历同步（可选；不填则仅本地存储，不同步日历）
# 请在 https://appleid.apple.com 生成「App 专用密码」，不要用 Apple ID 登录密码
ICLOUD_APPLE_ID=your@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 可选：指定日历显示名称；不填则使用账号下第一个日历
# ICLOUD_CALENDAR_NAME=待办

# docker-compose 映射到本机回环地址的端口（默认 127.0.0.1:8080 → 容器 3000）
# 生产请用本机 nginx 反代并终止 HTTPS，不要把该端口直接暴露公网
HOST_PORT=8080

# 已完成事项本地清理（不同步 iCloud）
# 超过 N 天的已完成事项会被删除；默认 30 天
# CLEANUP_COMPLETED_DAYS=30
# 清理定时间隔（小时）；默认 24，进程启动时也会先跑一轮
# CLEANUP_INTERVAL_HOURS=24
